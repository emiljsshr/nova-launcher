{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nova-launcher",
  "version": "0.1.0",
  "identifier": "com.emilschroderdeveloperaccount.nova-launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NOVA Launcher",
        "width": 1550,
        "height": 860,
        "resizable": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/instances/*/screenshots/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyMDkwQzUzNDRGNjc2MDYKUldRR2R2WkVVd3dKRWhpSWNodXBWY1A1V0lNc0dnQ09wUUlERUN5VGYxaDBlRHFDcStZM2NSSFYK",
      "endpoints": [
        "https://github.com/emiljsshr/nova-launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
